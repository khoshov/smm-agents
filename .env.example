# Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# Flowise Configuration
FLOWISE_HOST=http://localhost:3000
FLOWISE_ID=your_flowise_id_here

# Telegram Bot Tokens
MODERATOR_BOT_TOKEN=your_moderator_bot_token_here
PUBLISHER_BOT_TOKEN=your_publisher_bot_token_here

# Channel Configuration
CHANNEL_ID=@your_channel_name

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./telegram_bot.db

# Database Credentials for Docker
DB_USER=smm_user
DB_PASSWORD=smm_password

# System Settings
LOG_LEVEL=INFO
PUBLISH_INTERVAL_SECONDS=300

# Development/Production
ENVIRONMENT=development
